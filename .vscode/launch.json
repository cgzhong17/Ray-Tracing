{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug bin/main_dbg",
            "preLaunchTask": "make exe_dbg",
            "program": "${workspaceFolder}/bin/main_dbg",
            "args": [],
            "type": "cppdbg",
            "request": "launch",
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod",
                    "text": "-gdb-set debuginfod enabled off",
                    "ignoreFailures": true
                }
            ],
            "windows": { "externalConsole": false, "MIMode": "gdb" },
            "osx": { "externalConsole": false, "MIMode": "lldb" },
            "linux": { "externalConsole": false, "MIMode": "gdb" }
        }
    ]
}